<UserControl x:Class="UrbanoMetraj.BoQ.ManholeExcavationCatalog.UI.Views.ManholeExcavationCatalogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:UrbanoMetraj.BoQ.SmartAssembly.UI.Converters"
        xmlns:vm="clr-namespace:UrbanoMetraj.BoQ.ManholeExcavationCatalog.UI.ViewModels">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Proxy so ContextMenu items (outside the visual tree) can reach VM commands -->
        <conv:BindingProxy x:Key="VmProxy" Data="{Binding}"/>

        <Style x:Key="ColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="4,2"/>
            <Setter Property="Background" Value="#F0F0F0"/>
        </Style>

        <!-- Prominent primary-action (Kaydet) button — accent so it stands out. -->
        <Style x:Key="KaydetButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="10,2"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#00467F" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#9BB8CE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- ── Status bar ──────────────────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="Gray" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── Main content ────────────────────────────────────────────────── -->
        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="160"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════
                 LEFT — Rules list
                 ═══════════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Column="0">

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SecTitle}"
                           Text="Kazı Kuralları" Margin="0,0,0,6"/>

                <!-- Unified toolbar: [+ Kural Ekle] | [Kaydet] [İçe] [Dışa] | [↺ Yenile]
                     Çoğalt / Sil → satırda sağ tık (aşağıdaki DataGrid bağlam menüsü). -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button Content="+ Kural Ekle"
                            Command="{Binding AddRuleCommand}"
                            Padding="8,2" Margin="0,0,6,4"/>

                    <Separator Width="1" Height="20" Margin="0,0,6,4" Background="#BBBBBB"/>

                    <Button Content="💾 Kaydet"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource KaydetButton}" Margin="0,0,6,4"
                            ToolTip="Kazı kurallarını dahili konuma kaydeder&#x0a;(%APPDATA%\UrbanoMetraj\ManholeExcavCatalog.xml)"/>
                    <Button Content="İçe Aktar"
                            Command="{Binding ImportCommand}"
                            Padding="8,2" Margin="0,0,4,4"
                            ToolTip="Daha önce dışa aktarılmış bir XML dosyasını içe aktarır."/>
                    <Button Content="Dışa Aktar"
                            Command="{Binding ExportCommand}"
                            Padding="8,2" Margin="0,0,6,4"
                            ToolTip="Kuralları seçilen konuma XML olarak dışa aktarır."/>

                    <Separator Width="1" Height="20" Margin="0,0,6,4" Background="#BBBBBB"/>

                    <Button Content="↺ Yenile"
                            Command="{Binding RefreshCommand}"
                            Padding="8,2" Margin="0,0,0,4"
                            ToolTip="Smart Assembly'den eklenen yeni taban bileşenlerini ve aileleri yeniler."/>
                </WrapPanel>
                <TextBlock Text="(satırda sağ tık: Çoğalt / Sil)" Foreground="Gray"
                           FontSize="11" DockPanel.Dock="Top" Margin="0,0,0,4"/>

                <DataGrid ItemsSource="{Binding Rules}"
                          SelectedItem="{Binding SelectedRule}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          SelectionMode="Single"
                          PreviewMouseRightButtonDown="Grid_SelectRowOnRightClick"
                          ColumnHeaderStyle="{StaticResource ColHeader}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Çoğalt"
                                      Command="{Binding Data.DuplicateRuleCommand, Source={StaticResource VmProxy}}"/>
                            <MenuItem Header="Sil"
                                      Command="{Binding Data.DeleteRuleCommand, Source={StaticResource VmProxy}}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kural Adı"
                            Binding="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}"
                            Width="*"/>
                        <DataGridTemplateColumn Header="Min Ø (mm)" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MinBaseDiameterMm, StringFormat=Ø\{0:0\}}"
                                               VerticalAlignment="Center" Padding="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableBaseDiameters}"
                                              SelectedValue="{Binding MinBaseDiameterMm, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Display"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Maks Ø (mm)" Width="78">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MaxBaseDiameterMm, StringFormat=Ø\{0:0\}}"
                                               VerticalAlignment="Center" Padding="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableBaseDiameters}"
                                              SelectedValue="{Binding MaxBaseDiameterMm, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Display"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- ═══════════════════════════════════════════════════════════════
                 RIGHT — Detail (visible when a rule is selected)
                 ═══════════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Column="2"
                       Visibility="{Binding IsRuleSelected,
                                    Converter={StaticResource BoolToVis}}">

                <!-- Rule header: name + family + diameter range + zemin tipi -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="#BBBBBB" BorderThickness="1"
                        Background="#F5F5F5" Padding="10,7"
                        Margin="0,0,0,8">
                    <WrapPanel>

                        <!-- Kural Adı -->
                        <TextBlock Text="Kural Adı:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="150" Padding="4,2" Margin="0,0,18,0"
                                 Text="{Binding SelectedRule.RuleName,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Manhole Ailesi multi-select -->
                        <TextBlock Text="Manhole Ailesi:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Grid VerticalAlignment="Center" Margin="0,0,18,0">
                            <ToggleButton x:Name="FamilyDropdownBtn"
                                          MinWidth="130" MaxWidth="260"
                                          HorizontalContentAlignment="Left"
                                          Padding="6,3"
                                          IsChecked="{Binding SelectedRule.IsFamilyDropdownOpen,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                          Content="{Binding SelectedRule.SelectedFamiliesDisplay}"/>
                            <Popup IsOpen="{Binding SelectedRule.IsFamilyDropdownOpen,
                                           Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   PlacementTarget="{Binding ElementName=FamilyDropdownBtn}"
                                   Placement="Bottom" StaysOpen="False"
                                   MinWidth="{Binding ActualWidth, ElementName=FamilyDropdownBtn}">
                                <Border BorderBrush="#AAAAAA" BorderThickness="1"
                                        Background="White" MinWidth="130">
                                    <StackPanel>
                                        <CheckBox Content="Tümü" FontWeight="SemiBold"
                                                  IsThreeState="False"
                                                  IsChecked="{Binding SelectedRule.AllFamiliesSelected,
                                                              Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="8,6,8,2"/>
                                        <Separator Margin="0,2"/>
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SelectedRule.FamilyFilters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ManholeExcavFamilyFilterVm}">
                                                        <CheckBox Content="{Binding FamilyName}"
                                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,3"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Min Taban Ø -->
                        <TextBlock Text="Min Taban Ø (mm):" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="175" Padding="2,2" Margin="0,0,18,0"
                                  ItemsSource="{Binding SelectedRule.AvailableBaseDiameters}"
                                  SelectedValue="{Binding SelectedRule.MinBaseDiameterMm,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Display"/>

                        <!-- Maks Taban Ø -->
                        <TextBlock Text="Maks Taban Ø (mm):" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="175" Padding="2,2" Margin="0,0,10,0"
                                  ItemsSource="{Binding SelectedRule.AvailableBaseDiameters}"
                                  SelectedValue="{Binding SelectedRule.MaxBaseDiameterMm,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Display"/>
                        <TextBlock Text="(0 = sınırsız)" Foreground="Gray" FontStyle="Italic"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0"/>

                        <!-- Zemin Tipi multi-select -->
                        <TextBlock Text="Zemin Tipi:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Grid VerticalAlignment="Center">
                            <ToggleButton x:Name="SoilDropdownBtn"
                                          MinWidth="130" MaxWidth="260"
                                          HorizontalContentAlignment="Left"
                                          Padding="6,3"
                                          IsChecked="{Binding SelectedRule.IsSoilDropdownOpen,
                                                      Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Content="{Binding SelectedRule.SelectedSoilsDisplay}"/>
                            <Popup IsOpen="{Binding SelectedRule.IsSoilDropdownOpen,
                                           Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   PlacementTarget="{Binding ElementName=SoilDropdownBtn}"
                                   Placement="Bottom" StaysOpen="False"
                                   MinWidth="{Binding ActualWidth, ElementName=SoilDropdownBtn}">
                                <Border BorderBrush="#AAAAAA" BorderThickness="1"
                                        Background="White" MinWidth="130">
                                    <StackPanel>
                                        <CheckBox Content="Tümü" FontWeight="SemiBold"
                                                  IsThreeState="False"
                                                  IsChecked="{Binding SelectedRule.AllSoilsSelected,
                                                              Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="8,6,8,2"/>
                                        <Separator Margin="0,2"/>
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SelectedRule.SoilFilters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ManholeExcavSoilFilterVm}">
                                                        <CheckBox Content="{Binding SoilName}"
                                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,3"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                    </WrapPanel>
                </Border>

                <!-- Vertical split: tiers grid (top) / tier detail (bottom) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"   MinHeight="90"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="310" MinHeight="180"/>
                    </Grid.RowDefinitions>

                    <!-- ── Depth Tiers grid ──────────────────────────────── -->
                    <DockPanel Grid.Row="0">

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"
                                   LastChildFill="False">
                            <TextBlock Style="{StaticResource SecTitle}"
                                       Text="Derinlik Kademeleri"/>
                            <Button Content="Sil" DockPanel.Dock="Right"
                                    Command="{Binding SelectedRule.DeleteTierCommand}"
                                    Padding="8,2" Margin="4,0,0,0"/>
                            <Button Content="Çoğalt" DockPanel.Dock="Right"
                                    Command="{Binding SelectedRule.DuplicateTierCommand}"
                                    Padding="8,2" Margin="4,0,0,0"/>
                            <Button Content="+ Kademe Ekle" DockPanel.Dock="Right"
                                    Command="{Binding SelectedRule.AddTierCommand}"
                                    Padding="8,2"/>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding SelectedRule.DepthTiers}"
                                  SelectedItem="{Binding SelectedRule.SelectedTier}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single"
                                  ColumnHeaderStyle="{StaticResource ColHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Min (m)"
                                    Binding="{Binding MinDepthM,
                                              UpdateSourceTrigger=PropertyChanged,
                                              StringFormat=0.0}"
                                    Width="60"/>
                                <DataGridTextColumn Header="Maks (m)"
                                    Binding="{Binding MaxDepthM,
                                              UpdateSourceTrigger=PropertyChanged,
                                              StringFormat=0.0}"
                                    Width="60"/>
                                <DataGridTextColumn Header="Çalışma Gen. (m)"
                                    Binding="{Binding WorkingClearanceM,
                                              UpdateSourceTrigger=PropertyChanged,
                                              StringFormat=0.00}"
                                    Width="110"/>
                                <DataGridTextColumn Header="Şev (H:V)"
                                    Binding="{Binding SlopeRatio,
                                              UpdateSourceTrigger=PropertyChanged,
                                              StringFormat=0.0\#}"
                                    Width="75"/>
                                <DataGridCheckBoxColumn Header="İksa"
                                    Binding="{Binding RequiresShoring,
                                              UpdateSourceTrigger=PropertyChanged}"
                                    Width="50"/>
                                <DataGridCheckBoxColumn Header="Basamaklı"
                                    Binding="{Binding IsSteppedExcavation,
                                              UpdateSourceTrigger=PropertyChanged}"
                                    Width="78"/>
                                <DataGridTextColumn Header="Aralık"
                                    Binding="{Binding DepthRangeDisplay}"
                                    IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="5"
                                  HorizontalAlignment="Stretch"/>

                    <!-- ── Tier detail (visible when a tier is selected) ──── -->
                    <DockPanel Grid.Row="2"
                               Visibility="{Binding SelectedRule.IsTierSelected,
                                            Converter={StaticResource BoolToVis}}">

                        <!-- Stepped excavation params -->
                        <Border DockPanel.Dock="Top"
                                BorderBrush="#BBBBBB" BorderThickness="1"
                                Background="#F5F5F5" Padding="10,6"
                                Margin="0,0,0,8">
                            <WrapPanel>
                                <CheckBox Content="Basamaklı Kazı"
                                          IsChecked="{Binding SelectedRule.SelectedTier.IsSteppedExcavation,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock Text="Maks. Basamak Yük. (m):"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           IsEnabled="{Binding SelectedRule.SelectedTier.AreStepFieldsEnabled}"/>
                                <TextBox Width="72" Padding="4,2" Margin="0,0,18,0"
                                         IsEnabled="{Binding SelectedRule.SelectedTier.AreStepFieldsEnabled}"
                                         Text="{Binding SelectedRule.SelectedTier.MaxStepHeightM,
                                                UpdateSourceTrigger=PropertyChanged,
                                                StringFormat=0.0\#}"/>
                                <TextBlock Text="Berm Genişliği (m):"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           IsEnabled="{Binding SelectedRule.SelectedTier.AreStepFieldsEnabled}"/>
                                <TextBox Width="72" Padding="4,2"
                                         IsEnabled="{Binding SelectedRule.SelectedTier.AreStepFieldsEnabled}"
                                         Text="{Binding SelectedRule.SelectedTier.StepBermWidthM,
                                                UpdateSourceTrigger=PropertyChanged,
                                                StringFormat=0.0\#}"/>
                            </WrapPanel>
                        </Border>

                        <!-- Sub-base layers | Backfill layers (side by side) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sub-base layers -->
                            <DockPanel Grid.Column="0">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"
                                           LastChildFill="False">
                                    <TextBlock Style="{StaticResource SecTitle}"
                                               Text="Alt Temel Katmanları  (üstten alta)"/>
                                    <Button Content="Sil" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.DeleteSubBaseLayerCommand}"
                                            Padding="6,2" Margin="4,0,0,0"/>
                                    <Button Content="Çoğalt" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.DuplicateSubBaseLayerCommand}"
                                            Padding="6,2" Margin="4,0,0,0"/>
                                    <Button Content="+ Ekle" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.AddSubBaseLayerCommand}"
                                            Padding="6,2"/>
                                </DockPanel>
                                <DataGrid
                                    ItemsSource="{Binding SelectedRule.SelectedTier.SubBaseLayers}"
                                    SelectedItem="{Binding SelectedRule.SelectedTier.SelectedSubBaseLayer}"
                                    AutoGenerateColumns="False" CanUserAddRows="False"
                                    SelectionMode="Single"
                                    ColumnHeaderStyle="{StaticResource ColHeader}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Katman Adı"
                                            Binding="{Binding LayerName,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                                        <DataGridTemplateColumn Header="Malzeme" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MaterialType}"
                                                               VerticalAlignment="Center" Padding="4,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding AvailableDolguMaterials}"
                                                              SelectedValue="{Binding MaterialType, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Kalınlık (mm)"
                                            Binding="{Binding ThicknessMm,
                                                      UpdateSourceTrigger=PropertyChanged,
                                                      StringFormat=0}"
                                            Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" Width="6"
                                          HorizontalAlignment="Stretch"/>

                            <!-- Backfill layers -->
                            <DockPanel Grid.Column="2">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"
                                           LastChildFill="False">
                                    <TextBlock Style="{StaticResource SecTitle}"
                                               Text="Geri Dolgu Katmanları  (üstten alta)"/>
                                    <Button Content="Sil" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.DeleteBackfillLayerCommand}"
                                            Padding="6,2" Margin="4,0,0,0"/>
                                    <Button Content="Çoğalt" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.DuplicateBackfillLayerCommand}"
                                            Padding="6,2" Margin="4,0,0,0"/>
                                    <Button Content="+ Ekle" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.AddBackfillLayerCommand}"
                                            Padding="6,2"/>
                                </DockPanel>
                                <DataGrid
                                    ItemsSource="{Binding SelectedRule.SelectedTier.BackfillLayers}"
                                    SelectedItem="{Binding SelectedRule.SelectedTier.SelectedBackfillLayer}"
                                    AutoGenerateColumns="False" CanUserAddRows="False"
                                    SelectionMode="Single"
                                    ColumnHeaderStyle="{StaticResource ColHeader}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Katman Adı"
                                            Binding="{Binding LayerName,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                                        <DataGridTemplateColumn Header="Malzeme" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MaterialType}"
                                                               VerticalAlignment="Center" Padding="4,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding AvailableDolguMaterials}"
                                                              SelectedValue="{Binding MaterialType, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Thickness: greyed out when IsFillToSurface -->
                                        <DataGridTemplateColumn Header="Kalınlık (m)" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ThicknessM, StringFormat=0.00}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsThicknessEnabled}" Value="False">
                                                                        <Setter Property="Foreground" Value="Gray"/>
                                                                        <Setter Property="FontStyle"  Value="Italic"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox
                                                        Text="{Binding ThicknessM,
                                                               UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding IsThicknessEnabled}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridCheckBoxColumn Header="Yüzeye Doldur"
                                            Binding="{Binding IsFillToSurface,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                            Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>

                    <!-- Tier placeholder (no tier selected) -->
                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Text="Yukarıdaki tablodan bir derinlik kademesi seçin."
                               Foreground="Gray" FontStyle="Italic"
                               Visibility="{Binding SelectedRule.IsTierSelected,
                                            Converter={StaticResource BoolToVis},
                                            ConverterParameter=invert}"/>
                </Grid>
            </DockPanel>

            <!-- Right placeholder (no rule selected) -->
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="Soldaki listeden bir kazı kuralı seçin veya yeni kural ekleyin."
                       Foreground="Gray" FontStyle="Italic"
                       Visibility="{Binding IsRuleSelected,
                                    Converter={StaticResource BoolToVis},
                                    ConverterParameter=invert}"/>
        </Grid>
    </DockPanel>
</UserControl>
