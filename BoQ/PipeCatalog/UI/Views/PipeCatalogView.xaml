<UserControl x:Class="UrbanoMetraj.BoQ.PipeCatalogs.UI.Views.PipeCatalogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:UrbanoMetraj.BoQ.SmartAssembly.UI.Converters"
        xmlns:local="clr-namespace:UrbanoMetraj.BoQ.PipeCatalogs.UI.Views">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Proxy so DataGridTemplateColumn (outside visual tree) can reach the VM -->
        <conv:BindingProxy x:Key="VmProxy" Data="{Binding}"/>

        <Style x:Key="ColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="4,2"/>
            <Setter Property="Background" Value="#F0F0F0"/>
        </Style>

        <!-- Prominent primary-action (Kaydet) button — accent so it stands out from
             the quiet secondary buttons around it. -->
        <Style x:Key="KaydetButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="10,3"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#00467F" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#9BB8CE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact top-level menu button used for the İçe/Dışa dropdowns. -->
        <Style x:Key="AktarMenu" TargetType="MenuItem">
            <Setter Property="Padding" Value="8,3"/>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="Gray" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════
                 LEFT — Family list
                 ═══════════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Column="0">

                <TextBlock DockPanel.Dock="Top" Text="Boru Aileleri"
                           FontWeight="Bold" Margin="0,0,0,6"/>

                <!-- Unified toolbar: [+ Ekle] | [Kaydet] [İçe▾] [Dışa▾] | [⚙]
                     Aileyi Sil → sağ tık (aşağıdaki DataGrid bağlam menüsü). -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button Content="+ Ekle"
                            Command="{Binding AddFamilyCommand}"
                            Padding="8,2" Margin="0,0,6,4"
                            ToolTip="Yeni boru ailesi ekle"/>

                    <Separator Width="1" Height="20" Margin="0,0,6,4" Background="#BBBBBB"/>

                    <Button Content="💾 Kaydet"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource KaydetButton}"
                            Margin="0,0,6,4"
                            ToolTip="Kataloğu dahili konuma kaydeder&#x0a;(%APPDATA%\UrbanoMetraj\PipeCatalog.xml)"/>

                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,2,4">
                        <MenuItem Header="İçe Aktar ▾" Style="{StaticResource AktarMenu}">
                            <MenuItem Header="XML dosyasından…"
                                      Command="{Binding ImportCommand}"
                                      ToolTip="Native şema ve Urbano şeması otomatik algılanır."/>
                            <MenuItem Header="Excel dosyasından…"
                                      Command="{Binding ImportExcelCommand}"
                                      ToolTip="Sütunları eşleştirerek seçili aileye toplu boru ekler."/>
                        </MenuItem>
                    </Menu>
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,6,4">
                        <MenuItem Header="Dışa Aktar ▾" Style="{StaticResource AktarMenu}">
                            <MenuItem Header="XML olarak…"
                                      Command="{Binding ExportCommand}"
                                      ToolTip="Kataloğu seçilen konuma XML olarak dışa aktarır."/>
                            <MenuItem Header="Excel olarak…"
                                      Command="{Binding ExportExcelCommand}"
                                      ToolTip="Her aile ayrı sayfada; sütunlar içe aktarma başlıklarıyla aynıdır."/>
                        </MenuItem>
                    </Menu>

                    <Separator Width="1" Height="20" Margin="0,0,6,4" Background="#BBBBBB"/>

                    <Button Content="⚙ Sınıflar"
                            Command="{Binding ManageClassesCommand}"
                            Padding="8,2" Margin="0,0,0,4"
                            ToolTip="Katalog genelinde paylaşılan basınç / rijitlik sınıflarını düzenler (SN6, SN8, PN10…)&#x0a;Tüm aileler bu listeyi paylaşır."/>
                </WrapPanel>

                <DataGrid ItemsSource="{Binding Families}"
                          SelectedItem="{Binding SelectedFamily}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          SelectionMode="Single"
                          PreviewMouseRightButtonDown="Grid_SelectRowOnRightClick"
                          ColumnHeaderStyle="{StaticResource ColHeader}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Aileyi Sil"
                                      Command="{Binding Data.DeleteFamilyCommand,
                                                Source={StaticResource VmProxy}}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Aile Adı"
                            Binding="{Binding FamilyName, UpdateSourceTrigger=PropertyChanged}"
                            Width="*"/>
                        <DataGridTextColumn Header="Malzeme"
                            Binding="{Binding Material, UpdateSourceTrigger=PropertyChanged}"
                            Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- ═══════════════════════════════════════════════════════════════
                 RIGHT — Detail panel (visible when a family is selected)
                 ═══════════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Column="2"
                       Visibility="{Binding IsFamilySelected,
                                    Converter={StaticResource BoolToVis}}">

                <!-- Section A: editable family header -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="#BBBBBB" BorderThickness="1"
                        Background="#F5F5F5" Padding="10,8"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Aile Adı:"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1"
                                   Text="{Binding SelectedFamilyName,
                                          UpdateSourceTrigger=PropertyChanged}"
                                   Padding="4,2" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="3" Text="Malzeme:"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="4"
                                   Text="{Binding SelectedFamilyMaterial,
                                          UpdateSourceTrigger=PropertyChanged}"
                                   Padding="4,2" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Section B: pipe toolbar (Çoğalt / Sil → sağ tık bağlam menüsü) -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                    <TextBlock Text="Borular" FontWeight="Bold"
                               VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBlock Text="(satırda sağ tık: Çoğalt / Sil)" Foreground="Gray"
                               FontSize="11" VerticalAlignment="Center"
                               DockPanel.Dock="Left" Margin="8,0,0,0"/>
                    <Button Content="+ Ekle"
                            Command="{Binding AddPipeCommand}"
                            DockPanel.Dock="Right" Padding="8,2" Margin="4,0,0,0"/>
                </DockPanel>

                <!-- Section C: pipes DataGrid -->
                <DataGrid x:Name="PipesGrid"
                          ItemsSource="{Binding PipesInFamily}"
                          SelectedItem="{Binding SelectedPipe}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          SelectionMode="Single"
                          PreviewMouseRightButtonDown="Grid_SelectRowOnRightClick"
                          ColumnHeaderStyle="{StaticResource ColHeader}"
                          RowEditEnding="PipesGrid_RowEditEnding">

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Çoğalt"
                                      Command="{Binding Data.DuplicatePipeCommand,
                                                Source={StaticResource VmProxy}}"/>
                            <MenuItem Header="Sil"
                                      Command="{Binding Data.DeletePipeCommand,
                                                Source={StaticResource VmProxy}}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <!-- Red background when OD ≠ ID + 2×Et and all three are filled -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConsistent}" Value="False">
                                    <Setter Property="Background" Value="#FFEEEE"/>
                                    <Setter Property="ToolTip"
                                            Value="OD ≠ ID + 2×Et — değerler tutarsız!"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Poz No"
                            Binding="{Binding PozNo,
                                      UpdateSourceTrigger=PropertyChanged}"
                            Width="80"/>
                        <DataGridTextColumn Header="DN (mm)"
                            Binding="{Binding NominalDiameter,
                                      UpdateSourceTrigger=PropertyChanged,
                                      StringFormat=0}"
                            Width="65"/>
                        <DataGridTextColumn Header="OD (mm)"
                            Binding="{Binding OuterDiameter,
                                      UpdateSourceTrigger=PropertyChanged,
                                      StringFormat=0.0}"
                            Width="75"/>
                        <DataGridTextColumn Header="ID (mm)"
                            Binding="{Binding InnerDiameter,
                                      UpdateSourceTrigger=PropertyChanged,
                                      StringFormat=0.0}"
                            Width="75"/>
                        <DataGridTextColumn Header="Et (mm)"
                            Binding="{Binding WallThickness,
                                      UpdateSourceTrigger=PropertyChanged,
                                      StringFormat=0.0}"
                            Width="65"/>
                        <!-- Sınıf: ComboBox whose items come from the selected family's Classes list -->
                        <DataGridTemplateColumn Header="Sınıf" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Sinif}" Padding="2,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        IsEditable="False"
                                        SelectedItem="{Binding Sinif, UpdateSourceTrigger=PropertyChanged}"
                                        ItemsSource="{Binding Data.CatalogClasses,
                                                     Source={StaticResource VmProxy}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Açıklama"
                            Binding="{Binding Aciklama,
                                      UpdateSourceTrigger=PropertyChanged}"
                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Right placeholder (no family selected) -->
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="Soldaki listeden bir boru ailesi seçin veya yeni ekleyin."
                       Foreground="Gray" FontStyle="Italic"
                       Visibility="{Binding IsFamilySelected,
                                    Converter={StaticResource BoolToVis},
                                    ConverterParameter=invert}"/>
        </Grid>
    </DockPanel>
</UserControl>
