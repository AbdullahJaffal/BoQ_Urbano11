<UserControl x:Class="UrbanoMetraj.BoQ.PipeTrenchCatalog.UI.Views.PipeTrenchCatalogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:UrbanoMetraj.BoQ.SmartAssembly.UI.Converters"
        xmlns:vm="clr-namespace:UrbanoMetraj.BoQ.PipeTrenchCatalog.UI.ViewModels">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="4,2"/>
            <Setter Property="Background" Value="#F0F0F0"/>
        </Style>

        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- ── Status bar ──────────────────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="Gray" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── Main content ────────────────────────────────────────────────── -->
        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="210"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════
                 LEFT — Rules list
                 ═══════════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Column="0">

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SecTitle}"
                           Text="Hendek Kuralları" Margin="0,0,0,6"/>

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button Content="+ Kural Ekle"
                            Command="{Binding AddRuleCommand}"
                            Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="Kopyala"
                            Command="{Binding DuplicateRuleCommand}"
                            Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="Sil"
                            Command="{Binding DeleteRuleCommand}"
                            Padding="8,2" Margin="0,0,8,0"/>

                    <Separator Width="1" Height="20" Margin="0,0,8,0" Background="#BBBBBB"/>

                    <Button Content="💾 Kaydet"
                            Command="{Binding SaveCommand}"
                            Padding="8,2" Margin="0,0,4,0"
                            ToolTip="Hendek kurallarını dahili konuma kaydeder&#x0a;(%APPDATA%\UrbanoMetraj\PipeTrenchCatalog.xml)"/>
                    <Button Content="Dışa Aktar"
                            Command="{Binding ExportCommand}"
                            Padding="8,2" Margin="0,0,4,0"
                            ToolTip="Kuralları seçilen konuma XML olarak dışa aktarır."/>
                    <Button Content="İçe Aktar"
                            Command="{Binding ImportCommand}"
                            Padding="8,2"
                            ToolTip="Daha önce dışa aktarılmış bir XML dosyasını içe aktarır."/>
                </WrapPanel>

                <DataGrid ItemsSource="{Binding Rules}"
                          SelectedItem="{Binding SelectedRule}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          SelectionMode="Single"
                          ColumnHeaderStyle="{StaticResource ColHeader}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kural Adı"
                            Binding="{Binding RuleName,
                                      UpdateSourceTrigger=PropertyChanged}"
                            Width="*"/>
                        <DataGridTemplateColumn Header="Min Ø (mm)" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MinPipeDiameterMm, StringFormat=DN{0:0}}"
                                               VerticalAlignment="Center" Padding="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        ItemsSource="{Binding AvailableNominalDiameters}"
                                        SelectedValue="{Binding MinPipeDiameterMm,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                        ItemStringFormat="DN{0:0}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Maks Ø (mm)" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MaxPipeDiameterMm, StringFormat=DN{0:0}}"
                                               VerticalAlignment="Center" Padding="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        ItemsSource="{Binding AvailableNominalDiameters}"
                                        SelectedValue="{Binding MaxPipeDiameterMm,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                        ItemStringFormat="DN{0:0}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- ═══════════════════════════════════════════════════════════════
                 RIGHT — Detail (visible when a rule is selected)
                 ═══════════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Column="2"
                       Visibility="{Binding IsRuleSelected,
                                    Converter={StaticResource BoolToVis}}">

                <!-- Rule header: name + diameter range -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="#BBBBBB" BorderThickness="1"
                        Background="#F5F5F5" Padding="10,7"
                        Margin="0,0,0,8">
                    <WrapPanel>
                        <TextBlock Text="Kural Adı:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="160" Padding="4,2" Margin="0,0,20,0"
                                 Text="{Binding SelectedRule.RuleName,
                                        UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Min Boru Ø (mm):" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="110" Padding="2,2" Margin="0,0,20,0"
                                  ItemsSource="{Binding SelectedRule.AvailableNominalDiameters}"
                                  SelectedValue="{Binding SelectedRule.MinPipeDiameterMm,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                  ItemStringFormat="DN{0:0}"/>
                        <TextBlock Text="Maks Boru Ø (mm):" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="110" Padding="2,2" Margin="0,0,16,0"
                                  ItemsSource="{Binding SelectedRule.AvailableNominalDiameters}"
                                  SelectedValue="{Binding SelectedRule.MaxPipeDiameterMm,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                  ItemStringFormat="DN{0:0}"/>
                        <TextBlock Text="(0 = sınırsız üst çap)"
                                   Foreground="Gray" FontStyle="Italic" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <!-- Per-rule pipe-family multi-select dropdown -->
                        <TextBlock Text="Boru Ailesi:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Grid VerticalAlignment="Center">
                            <ToggleButton x:Name="FamilyDropdownBtn"
                                          MinWidth="140" MaxWidth="280"
                                          HorizontalContentAlignment="Left"
                                          Padding="6,3"
                                          IsChecked="{Binding SelectedRule.IsFamilyDropdownOpen,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                          Content="{Binding SelectedRule.SelectedFamiliesDisplay}"/>
                            <Popup IsOpen="{Binding SelectedRule.IsFamilyDropdownOpen,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"
                                   PlacementTarget="{Binding ElementName=FamilyDropdownBtn}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   MinWidth="{Binding ActualWidth,
                                              ElementName=FamilyDropdownBtn}">
                                <Border BorderBrush="#AAAAAA" BorderThickness="1"
                                        Background="White" MinWidth="140">
                                    <StackPanel>
                                        <CheckBox Content="Tümü" FontWeight="SemiBold"
                                                  IsThreeState="False"
                                                  IsChecked="{Binding SelectedRule.AllFamiliesSelected,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="8,6,8,2"/>
                                        <Separator Margin="0,2"/>
                                        <ScrollViewer MaxHeight="200"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SelectedRule.FamilyFilters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding FamilyName}"
                                                                  IsChecked="{Binding IsSelected,
                                                                              UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,3"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <!-- Per-rule zemin-tipi multi-select dropdown -->
                        <TextBlock Text="Zemin Tipi:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <Grid VerticalAlignment="Center">
                            <ToggleButton x:Name="SoilDropdownBtn"
                                          MinWidth="140" MaxWidth="280"
                                          HorizontalContentAlignment="Left"
                                          Padding="6,3"
                                          IsChecked="{Binding SelectedRule.IsSoilDropdownOpen,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                          Content="{Binding SelectedRule.SelectedSoilsDisplay}"/>
                            <Popup IsOpen="{Binding SelectedRule.IsSoilDropdownOpen,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"
                                   PlacementTarget="{Binding ElementName=SoilDropdownBtn}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   MinWidth="{Binding ActualWidth,
                                              ElementName=SoilDropdownBtn}">
                                <Border BorderBrush="#AAAAAA" BorderThickness="1"
                                        Background="White" MinWidth="140">
                                    <StackPanel>
                                        <CheckBox Content="Tümü" FontWeight="SemiBold"
                                                  IsThreeState="False"
                                                  IsChecked="{Binding SelectedRule.AllSoilsSelected,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="8,6,8,2"/>
                                        <Separator Margin="0,2"/>
                                        <ScrollViewer MaxHeight="200"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SelectedRule.SoilFilters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding SoilName}"
                                                                  IsChecked="{Binding IsSelected,
                                                                              UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,3"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </WrapPanel>
                </Border>

                <!-- Vertical split: tiers grid (top) / tier detail (bottom) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"   MinHeight="90"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="330" MinHeight="200"/>
                    </Grid.RowDefinitions>

                    <!-- ── Depth Tiers grid ──────────────────────────────── -->
                    <DockPanel Grid.Row="0">

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"
                                   LastChildFill="False">
                            <TextBlock Style="{StaticResource SecTitle}"
                                       Text="Derinlik Kademeleri"/>
                            <Button Content="Sil" DockPanel.Dock="Right"
                                    Command="{Binding SelectedRule.DeleteTierCommand}"
                                    Padding="8,2" Margin="4,0,0,0"/>
                            <Button Content="Kopyala" DockPanel.Dock="Right"
                                    Command="{Binding SelectedRule.DuplicateTierCommand}"
                                    Padding="8,2" Margin="4,0,0,0"/>
                            <Button Content="+ Kademe Ekle" DockPanel.Dock="Right"
                                    Command="{Binding SelectedRule.AddTierCommand}"
                                    Padding="8,2"/>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding SelectedRule.DepthTiers}"
                                  SelectedItem="{Binding SelectedRule.SelectedTier}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single"
                                  ColumnHeaderStyle="{StaticResource ColHeader}">
                            <DataGrid.Columns>
                                <!-- Min (m): first row is locked at 0.000 -->
                                <DataGridTemplateColumn Header="Min (m)" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MinDepthM, StringFormat=0.000}"
                                                       VerticalAlignment="Center" Padding="2,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMinDepthEditable}" Value="False">
                                                                <Setter Property="Foreground" Value="Gray"/>
                                                                <Setter Property="FontStyle"  Value="Italic"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding MinDepthM,
                                                             UpdateSourceTrigger=PropertyChanged,
                                                             StringFormat=0.000}"
                                                     IsEnabled="{Binding IsMinDepthEditable}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Maks (m)"
                                    Binding="{Binding MaxDepthM,
                                              UpdateSourceTrigger=PropertyChanged,
                                              StringFormat=0.000}"
                                    Width="72"/>
                                <DataGridTextColumn Header="Gen. Boşl. (m)"
                                    Binding="{Binding TrenchWidthClearanceM,
                                              UpdateSourceTrigger=PropertyChanged,
                                              StringFormat=0.000}"
                                    Width="90"/>
                                <DataGridTextColumn Header="Şev (H:V)"
                                    Binding="{Binding SlopeRatio,
                                              UpdateSourceTrigger=PropertyChanged,
                                              StringFormat=0.0\#}"
                                    Width="72"/>
                                <DataGridCheckBoxColumn Header="İksa"
                                    Binding="{Binding RequiresShoring,
                                              UpdateSourceTrigger=PropertyChanged}"
                                    Width="46"/>
                                <DataGridCheckBoxColumn Header="Basamaklı"
                                    Binding="{Binding IsSteppedExcavation,
                                              UpdateSourceTrigger=PropertyChanged}"
                                    Width="76"/>
                                <DataGridTextColumn Header="Maks Basamak (m)"
                                    Binding="{Binding MaxStepHeightM,
                                              UpdateSourceTrigger=PropertyChanged,
                                              StringFormat=0.000}"
                                    Width="108"/>
                                <DataGridTextColumn Header="Berm Gen. (m)"
                                    Binding="{Binding StepBermWidthM,
                                              UpdateSourceTrigger=PropertyChanged,
                                              StringFormat=0.000}"
                                    Width="88"/>
                                <DataGridTextColumn Header="Aralık"
                                    Binding="{Binding DepthRangeDisplay}"
                                    IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="5"
                                  HorizontalAlignment="Stretch"/>

                    <!-- ── Tier detail (visible when a tier is selected) ──── -->
                    <DockPanel Grid.Row="2"
                               Visibility="{Binding SelectedRule.IsTierSelected,
                                            Converter={StaticResource BoolToVis}}">

                        <!-- Stepped excavation params -->
                        <Border DockPanel.Dock="Top"
                                BorderBrush="#BBBBBB" BorderThickness="1"
                                Background="#F5F5F5" Padding="10,6"
                                Margin="0,0,0,8">
                            <WrapPanel>
                                <CheckBox Content="Basamaklı Kazı (Kademeli)"
                                          IsChecked="{Binding SelectedRule.SelectedTier.IsSteppedExcavation,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock Text="Maks. Basamak Yük. (m):"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           IsEnabled="{Binding SelectedRule.SelectedTier.AreStepFieldsEnabled}"/>
                                <TextBox Width="72" Padding="4,2" Margin="0,0,18,0"
                                         IsEnabled="{Binding SelectedRule.SelectedTier.AreStepFieldsEnabled}"
                                         Text="{Binding SelectedRule.SelectedTier.MaxStepHeightM,
                                                UpdateSourceTrigger=PropertyChanged,
                                                StringFormat=0.000}"/>
                                <TextBlock Text="Berm Genişliği (m):"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           IsEnabled="{Binding SelectedRule.SelectedTier.AreStepFieldsEnabled}"/>
                                <TextBox Width="72" Padding="4,2"
                                         IsEnabled="{Binding SelectedRule.SelectedTier.AreStepFieldsEnabled}"
                                         Text="{Binding SelectedRule.SelectedTier.StepBermWidthM,
                                                UpdateSourceTrigger=PropertyChanged,
                                                StringFormat=0.000}"/>
                            </WrapPanel>
                        </Border>

                        <!-- Bedding | Gömlekleme | Backfill layers (side by side) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Yataklama -->
                            <DockPanel Grid.Column="0">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"
                                           LastChildFill="False">
                                    <TextBlock Style="{StaticResource SecTitle}"
                                               Text="Yataklama Katmanları  (alttan üste)"/>
                                    <Button Content="Sil" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.DeleteBeddingLayerCommand}"
                                            Padding="6,2" Margin="4,0,0,0"/>
                                    <Button Content="+ Ekle" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.AddBeddingLayerCommand}"
                                            Padding="6,2"/>
                                </DockPanel>
                                <DataGrid
                                    ItemsSource="{Binding SelectedRule.SelectedTier.BeddingLayers}"
                                    SelectedItem="{Binding SelectedRule.SelectedTier.SelectedBeddingLayer}"
                                    AutoGenerateColumns="False" CanUserAddRows="False"
                                    SelectionMode="Single"
                                    ColumnHeaderStyle="{StaticResource ColHeader}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Katman Adı"
                                            Binding="{Binding LayerName,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                                        <DataGridTemplateColumn Header="Malzeme" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MaterialType}"
                                                               VerticalAlignment="Center" Padding="2,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox
                                                        ItemsSource="{x:Static vm:TrenchLayerVm.AvailableMaterials}"
                                                        DisplayMemberPath="DolguAdi"
                                                        SelectedValuePath="DolguAdi"
                                                        SelectedValue="{Binding MaterialType,
                                                                        UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Kalınlık (m)"
                                            Binding="{Binding ThicknessM,
                                                      UpdateSourceTrigger=PropertyChanged,
                                                      StringFormat=0.000}"
                                            Width="84"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" Width="6"
                                          HorizontalAlignment="Stretch"/>

                            <!-- Gömlekleme -->
                            <DockPanel Grid.Column="2">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"
                                           LastChildFill="False">
                                    <TextBlock Style="{StaticResource SecTitle}"
                                               Text="Gömlekleme Katmanları  (alttan üste)"/>
                                    <Button Content="Sil" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.DeleteGomleklemeLayerCommand}"
                                            Padding="6,2" Margin="4,0,0,0"/>
                                    <Button Content="+ Ekle" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.AddGomleklemeLayerCommand}"
                                            Padding="6,2"/>
                                </DockPanel>
                                <DataGrid
                                    ItemsSource="{Binding SelectedRule.SelectedTier.GomleklemeLayers}"
                                    SelectedItem="{Binding SelectedRule.SelectedTier.SelectedGomleklemeLayer}"
                                    AutoGenerateColumns="False" CanUserAddRows="False"
                                    SelectionMode="Single"
                                    ColumnHeaderStyle="{StaticResource ColHeader}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Katman Adı"
                                            Binding="{Binding LayerName,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                                        <DataGridTemplateColumn Header="Malzeme" Width="88">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MaterialType}"
                                                               VerticalAlignment="Center" Padding="2,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox
                                                        ItemsSource="{x:Static vm:GomleklemeLayerVm.AvailableMaterials}"
                                                        DisplayMemberPath="DolguAdi"
                                                        SelectedValuePath="DolguAdi"
                                                        SelectedValue="{Binding MaterialType,
                                                                        UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- Position: boru etrafı / boru üstü -->
                                        <DataGridTemplateColumn Header="Pozisyon" Width="88">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Position}"
                                                               VerticalAlignment="Center"
                                                               Padding="2,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox
                                                        ItemsSource="{x:Static vm:GomleklemeLayerVm.Positions}"
                                                        SelectedValue="{Binding Position,
                                                                        UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- Kalınlık: locked when IsUpToPipeTop is checked -->
                                        <DataGridTemplateColumn Header="Kalınlık (m)" Width="78">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ThicknessM, StringFormat=0.000}"
                                                               VerticalAlignment="Center" Padding="2,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsThicknessEnabled}" Value="False">
                                                                        <Setter Property="Foreground" Value="Gray"/>
                                                                        <Setter Property="FontStyle"  Value="Italic"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding ThicknessM,
                                                                    UpdateSourceTrigger=PropertyChanged,
                                                                    StringFormat=0.000}"
                                                             IsEnabled="{Binding IsThicknessEnabled}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- Only enabled when Position == "boru etrafı" -->
                                        <DataGridTemplateColumn Header="Boru Üstüne" Width="82">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox
                                                        IsChecked="{Binding IsUpToPipeTop,
                                                                    UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding IsUpToPipeTopEnabled}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <GridSplitter Grid.Column="3" Width="6"
                                          HorizontalAlignment="Stretch"/>

                            <!-- Geri Dolgu -->
                            <DockPanel Grid.Column="4">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"
                                           LastChildFill="False">
                                    <TextBlock Style="{StaticResource SecTitle}"
                                               Text="Geri Dolgu Katmanları  (alttan üste)"/>
                                    <Button Content="Sil" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.DeleteBackfillLayerCommand}"
                                            Padding="6,2" Margin="4,0,0,0"/>
                                    <Button Content="+ Ekle" DockPanel.Dock="Right"
                                            Command="{Binding SelectedRule.SelectedTier.AddBackfillLayerCommand}"
                                            Padding="6,2"/>
                                </DockPanel>
                                <DataGrid
                                    ItemsSource="{Binding SelectedRule.SelectedTier.BackfillLayers}"
                                    SelectedItem="{Binding SelectedRule.SelectedTier.SelectedBackfillLayer}"
                                    AutoGenerateColumns="False" CanUserAddRows="False"
                                    SelectionMode="Single"
                                    ColumnHeaderStyle="{StaticResource ColHeader}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Katman Adı"
                                            Binding="{Binding LayerName,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                                        <DataGridTemplateColumn Header="Malzeme" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MaterialType}"
                                                               VerticalAlignment="Center" Padding="2,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox
                                                        ItemsSource="{x:Static vm:TrenchLayerVm.AvailableMaterials}"
                                                        DisplayMemberPath="DolguAdi"
                                                        SelectedValuePath="DolguAdi"
                                                        SelectedValue="{Binding MaterialType,
                                                                        UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Thickness: greyed out when IsFillToSurface -->
                                        <DataGridTemplateColumn Header="Kalınlık (m)" Width="82">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ThicknessM, StringFormat=0.000}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsThicknessEnabled}" Value="False">
                                                                        <Setter Property="Foreground" Value="Gray"/>
                                                                        <Setter Property="FontStyle"  Value="Italic"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox
                                                        Text="{Binding ThicknessM,
                                                               UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding IsThicknessEnabled}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridCheckBoxColumn Header="Yüzeye Doldur"
                                            Binding="{Binding IsFillToSurface,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                            Width="92"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>

                    <!-- Tier placeholder (no tier selected) -->
                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Text="Yukarıdaki tablodan bir derinlik kademesi seçin."
                               Foreground="Gray" FontStyle="Italic"
                               Visibility="{Binding SelectedRule.IsTierSelected,
                                            Converter={StaticResource BoolToVis},
                                            ConverterParameter=invert}"/>
                </Grid>
            </DockPanel>

            <!-- Right placeholder (no rule selected) -->
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="Soldaki listeden bir hendek kuralı seçin veya yeni kural ekleyin."
                       Foreground="Gray" FontStyle="Italic"
                       Visibility="{Binding IsRuleSelected,
                                    Converter={StaticResource BoolToVis},
                                    ConverterParameter=invert}"/>
        </Grid>
    </DockPanel>
</UserControl>
