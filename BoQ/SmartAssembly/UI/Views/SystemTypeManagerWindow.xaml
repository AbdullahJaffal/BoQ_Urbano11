<Window x:Class="UrbanoMetraj.BoQ.SmartAssembly.UI.Views.SystemTypeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:beh="clr-namespace:UrbanoMetraj.BoQ.SmartAssembly.UI.Behaviors"
        Title="Sistem Tipi Yönetimi"
        Width="380" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <DockPanel Margin="8">

        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Kaydet"  Width="80" Click="OnSave"   IsDefault="True"/>
            <Button Content="İptal"   Width="80" Click="OnCancel" IsCancel="True" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="+ Ekle" Command="{Binding AddCommand}"    ToolTip="Yeni sistem tipi ekle"/>
                <TextBlock Text="(sağ tık: Sil — Ctrl/Shift ile çoklu seçim)" Foreground="Gray"
                           FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </ToolBar>
        </ToolBarTray>

        <!-- List -->
        <DataGrid ItemsSource="{Binding SystemTypes}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  beh:GridBulk.Enable="True"
                  beh:GridBulk.AddCommand="{Binding AddCommand}"
                  beh:GridBulk.DeleteCommand="{Binding DeleteCommand}"
                  Margin="0,4,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sistem Tipi Adı"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
