<Window x:Class="UrbanoMetraj.BoQ.SmartAssembly.UI.Views.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:UrbanoMetraj.BoQ.SmartAssembly.UI.Converters"
        xmlns:typeMap="clr-namespace:UrbanoMetraj.BoQ.TypeMapping.UI.Views"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Proje Ayarları"
        Width="1150" Height="720"
        MinWidth="900" MinHeight="560"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:NullToVisibilityConverter  x:Key="NullToVis"/>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVis"/>
        <!-- Proxy so ContextMenu items (outside the visual tree) can reach VM commands -->
        <conv:BindingProxy x:Key="VmProxy" Data="{Binding}"/>

        <!-- Prominent primary-action button — accent so it stands out. -->
        <Style x:Key="KaydetButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="8,3"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#00467F" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#9BB8CE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SutunBasligi" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="4,2"/>
            <Setter Property="Background" Value="#F0F0F0"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock Text="Proje Ayarları — Proje Kurulumu (DWG) &amp; Tür Eşleştirme"
                           Foreground="Gray" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="4">

            <!-- ═══════════════════════════════════════════════════════════════
                 Proje Kurulumu (DWG) — per-network project rule source.
                 Bound to SmartAssemblyMainVm.ProjectRulesTab (ProjectRulesTabVm).
                 See PROJECT_RULES_REDESIGN.md.
                 ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="Proje Kurulumu (DWG)">
                <DockPanel Margin="6" DataContext="{Binding ProjectRulesTab}">

                    <!-- Üst: hesap modu anahtarı + eylemler -->
                    <Border DockPanel.Dock="Top" BorderBrush="#CCC" BorderThickness="0,0,0,1"
                            Padding="0,0,0,8" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="Hesap Modu:" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <RadioButton Content="Kurallar (bu sayfa)" GroupName="CalcMode"
                                             VerticalAlignment="Center" Margin="0,0,12,0"
                                             IsChecked="{Binding IsRulesMode, Mode=TwoWay}"/>
                                <RadioButton Content="Tür Eşleştirme" GroupName="CalcMode"
                                             VerticalAlignment="Center" Margin="0,0,16,0"
                                             IsChecked="{Binding IsTypeMappingMode, Mode=TwoWay}"/>
                                <Separator Width="1" Height="18" Margin="0,0,12,0" Background="#BBBBBB"/>
                                <Button Content="Kaydet" Command="{Binding SaveCommand}"
                                        Style="{StaticResource KaydetButton}" Margin="0,0,6,0"
                                        ToolTip="Kuralları aktif DWG'ye kaydet"/>
                                <Button Content="↻ Yenile" Command="{Binding RefreshCommand}"
                                        Padding="8,3" Margin="0,0,6,0"
                                        ToolTip="Ağ listesini ve aktif durumları çizimden yeniden oku"/>
                                <Button Content="Dışa Aktar (XML)" Command="{Binding ExportXmlCommand}"
                                        Padding="8,3" Margin="0,0,6,0"
                                        ToolTip="Kuralları taşınabilir XML olarak dışa aktar (istisnalar hariç)"/>
                                <Button Content="İçe Aktar (XML)" Command="{Binding ImportXmlCommand}"
                                        Padding="8,3"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ModeSummary}" Foreground="#00467F"
                                       FontStyle="Italic" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Alt: durum satırı -->
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}"
                               Foreground="Gray" FontSize="11" Margin="0,6,0,0"/>

                    <!-- İstisnalar (CAD seçimi ile) — seçili ağa özel; pick o ağın "<ağ>_*" katmanlarına süzülür -->
                    <Expander DockPanel.Dock="Bottom" Header="İstisnalar (CAD seçimi ile — seçili ağa özel)"
                              IsExpanded="False" Margin="0,6,0,0" IsEnabled="{Binding IsRulesMode}">
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,4,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="170"/>
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                    <Button Content="XML Güncelle"
                                            Command="{Binding ExtractXmlCommand}" Padding="8,3" Margin="0,0,6,0"
                                            ToolTip="Urbano'dan güncel ağ verisini çeker (UT_BOQ) ve export XML'ini yeniler."/>
                                    <Button Content="↻ İsimleri Güncelle (XML)"
                                            Command="{Binding RefreshExceptionNamesCommand}" Padding="8,3"
                                            ToolTip="Metraj Verisi (XML) çıkarıldıktan sonra: AG_GUID'leri baca/boru adlarına çevirir, XML'de olmayanları siler."/>
                                    <TextBlock Text="Yalnızca seçili ağın katmanları seçilebilir. Boru = çizgi/polyline, Baca = blok/daire. Metinler yok sayılır."
                                               Foreground="Gray" FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </WrapPanel>

                                <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                                    <TextBlock Text="Boru İstisnası:" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Width="95"/>
                                    <TextBlock Text="Aile" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox Width="150" Margin="0,0,8,0"
                                              ItemsSource="{Binding AvailableExcPipeFamilies}"
                                              DisplayMemberPath="FamilyName"
                                              SelectedItem="{Binding ExcPipeFamily, Mode=TwoWay}"/>
                                    <TextBlock Text="Sınıf" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox Width="110" Margin="0,0,8,0"
                                              ItemsSource="{Binding ExcPipeSinifs}"
                                              SelectedItem="{Binding ExcPipeSinif, Mode=TwoWay}"/>
                                    <Button Content="Seç ve Ekle" Command="{Binding AddPipeExceptionCommand}"
                                            Padding="8,3" ToolTip="Çizimden boru seç ve bu türü istisna olarak ata"/>
                                </WrapPanel>

                                <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                                    <TextBlock Text="Baca İstisnası:" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Width="95"/>
                                    <TextBlock Text="Aile" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox Width="150" Margin="0,0,8,0"
                                              ItemsSource="{Binding AvailableExcManholeFamilies}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{Binding ExcManholeFamily, Mode=TwoWay}"/>
                                    <TextBlock Text="Çap" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox Width="90" Margin="0,0,8,0" ItemStringFormat="{}Ø{0:0}"
                                              ItemsSource="{Binding AvailableExcManholeDiameters}"
                                              SelectedItem="{Binding ExcManholeDiameter, Mode=TwoWay}"
                                              ToolTip="Seçilen ailenin Taban çapı — istisna bacaların çapı buradan sabitlenir"/>
                                    <Button Content="Seç ve Ekle" Command="{Binding AddManholeExceptionCommand}"
                                            Padding="8,3" ToolTip="Çizimden baca seç, bu aile + çapı istisna olarak ata"/>
                                </WrapPanel>

                                <WrapPanel Grid.Row="3" Margin="0,0,0,6">
                                    <TextBlock Text="Boru Kazı İst.:" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Width="95"/>
                                    <TextBlock Text="Zemin" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox Width="130" Margin="0,0,8,0"
                                              ItemsSource="{Binding AvailableExcSoils}"
                                              SelectedItem="{Binding ExcExcavPipeSoil, Mode=TwoWay}"/>
                                    <TextBlock Text="Kural" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox Width="150" Margin="0,0,8,0"
                                              ItemsSource="{Binding ExcavPipeRuleOptions}"
                                              SelectedItem="{Binding ExcExcavPipeRule, Mode=TwoWay}"/>
                                    <Button Content="Seç ve Ekle" Command="{Binding AddPipeExcavExceptionCommand}"
                                            Padding="8,3" ToolTip="Çizimden boru seç, bu zemin + kural filtresini kazı istisnası olarak ata"/>
                                </WrapPanel>

                                <WrapPanel Grid.Row="4" Margin="0,0,0,6">
                                    <TextBlock Text="Baca Kazı İst.:" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Width="95"/>
                                    <TextBlock Text="Zemin" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox Width="130" Margin="0,0,8,0"
                                              ItemsSource="{Binding AvailableExcSoils}"
                                              SelectedItem="{Binding ExcExcavMhSoil, Mode=TwoWay}"/>
                                    <TextBlock Text="Kural" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox Width="150" Margin="0,0,8,0"
                                              ItemsSource="{Binding ExcavMhRuleOptions}"
                                              SelectedItem="{Binding ExcExcavMhRule, Mode=TwoWay}"/>
                                    <Button Content="Seç ve Ekle" Command="{Binding AddManholeExcavExceptionCommand}"
                                            Padding="8,3" ToolTip="Çizimden baca seç, bu zemin + kural filtresini kazı istisnası olarak ata"/>
                                </WrapPanel>

                                <DataGrid Grid.Row="5" ItemsSource="{Binding Exceptions}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          ColumnHeaderStyle="{StaticResource SutunBasligi}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tür" Binding="{Binding Dimension}" Width="70"/>
                                        <DataGridTextColumn Header="Öğe" Binding="{Binding Display}" Width="180"/>
                                        <DataGridTextColumn Header="Atanan Tür" Binding="{Binding OverrideLabel}" Width="*"/>
                                        <DataGridTemplateColumn Header="" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Sil" Padding="6,1"
                                                            Command="{Binding DataContext.DeleteExceptionCommand,
                                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Expander>

                    <!-- Ağ listesi (sol) + ağ editörü (sağ) — sadece Kurallar modunda etkin -->
                    <Grid IsEnabled="{Binding IsRulesMode}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Ağlar" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ListBox ItemsSource="{Binding Networks}"
                                     SelectedItem="{Binding SelectedNetwork}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SystemName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="  ● Aktif" Foreground="#2E7D32" FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RuleSummary}" Foreground="Gray" FontSize="10.5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                        <!-- Seçili ağın editörü -->
                        <Border Grid.Column="2"
                                Visibility="{Binding IsNetworkSelected, Converter={StaticResource BoolToVis}}">
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedNetwork}" Margin="6,0,0,0">
                                <TextBlock Text="{Binding SystemName}" FontWeight="Bold"
                                           FontSize="14" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Zemin Tipi:" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Width="220" ItemsSource="{Binding AvailableSoils}"
                                              SelectedItem="{Binding SelectedSoilName, Mode=TwoWay}"
                                              ToolTip="Kazı fiyatlandırması (poz/kabarma) ve hendek/baca kazı kuralı seçimi bu zemin tipine göre yapılır"/>
                                </StackPanel>

                                <GroupBox Header="Boru" Padding="8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="240"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0" Content="Aile:"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                                  ItemsSource="{Binding AvailablePipeFamilies}"
                                                  DisplayMemberPath="FamilyName"
                                                  SelectedItem="{Binding SelectedPipeFamily, Mode=TwoWay}"/>
                                        <Label Grid.Row="1" Grid.Column="0" Content="Sınıf:"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                                  ItemsSource="{Binding AvailableSinifs}"
                                                  SelectedItem="{Binding SelectedSinif, Mode=TwoWay}"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Baca" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="240"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="Aile:"/>
                                        <ComboBox Grid.Column="1" Margin="0,2"
                                                  ItemsSource="{Binding AvailableManholeFamilies}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedManholeFamily, Mode=TwoWay}"/>
                                    </Grid>
                                </GroupBox>

                                <!-- Bağlantı Kuralları (baca seçim) — pipe-range → depth tier → manhole Ø + parça sayısı -->
                                <GroupBox Header="Bağlantı Kuralları (baca seçim)" Padding="6" Margin="0,10,0,0">
                                    <StackPanel>
                                        <ToolBarTray DockPanel.Dock="Top">
                                            <ToolBar>
                                                <Button Content="Katalogdan İçe Aktar"
                                                        Command="{Binding ImportConnRulesCommand}"
                                                        ToolTip="Ana katalog kurallarını (baca çapı = Taban üst açıklığı) bu ağa kopyala"/>
                                                <Separator/>
                                                <TextBlock Text="Boru Aralığı:" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" Margin="4,0,4,0"/>
                                                <Button Content="+ Ekle" Command="{Binding AddConnRuleCommand}"/>
                                                <Button Content="Sil"    Command="{Binding DeleteConnRuleCommand}" Margin="2,0,0,0"/>
                                                <Separator/>
                                                <TextBlock Text="Katman:" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" Margin="4,0,4,0"/>
                                                <Button Content="+ Ekle" Command="{Binding AddTierCommand}"/>
                                                <Button Content="Sil"    Command="{Binding DeleteTierCommand}" Margin="2,0,0,0"/>
                                            </ToolBar>
                                        </ToolBarTray>
                                        <Grid Height="210">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <DataGrid Grid.Column="0" ItemsSource="{Binding ConnectionRules}"
                                                      SelectedItem="{Binding SelectedConnRule}"
                                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                                      SelectionMode="Single" HeadersVisibility="Column"
                                                      ColumnHeaderStyle="{StaticResource SutunBasligi}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Min Boru (mm)" Width="*"
                                                        Binding="{Binding MinPipeMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0}"/>
                                                    <DataGridTextColumn Header="Max Boru (mm)" Width="*"
                                                        Binding="{Binding MaxPipeMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0}"/>
                                                    <DataGridTextColumn Header="Kat." Width="38" IsReadOnly="True"
                                                        Binding="{Binding TierCount}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                                            <DataGrid Grid.Column="2" ItemsSource="{Binding SelectedConnRule.Tiers}"
                                                      SelectedItem="{Binding SelectedTier}"
                                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                                      SelectionMode="Single" HeadersVisibility="Column"
                                                      ColumnHeaderStyle="{StaticResource SutunBasligi}"
                                                      Visibility="{Binding IsConnRuleSelected, Converter={StaticResource BoolToVis}}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Min Der. (m)" Width="78"
                                                        Binding="{Binding MinDepthM, UpdateSourceTrigger=PropertyChanged, StringFormat=0.0}"/>
                                                    <DataGridTextColumn Header="Max Der. (m)" Width="78"
                                                        Binding="{Binding MaxDepthM, UpdateSourceTrigger=PropertyChanged, StringFormat=0.0}"/>
                                                    <DataGridTemplateColumn Header="Baca Çapı (mm)" Width="110">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding ManholeDiameterMm, StringFormat=0}"
                                                                           VerticalAlignment="Center" Padding="4,0"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                        <DataGridTemplateColumn.CellEditingTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemStringFormat="{}{0:0}"
                                                                          ItemsSource="{Binding DataContext.AvailableManholeDiameters,
                                                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                          SelectedItem="{Binding ManholeDiameterMm, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellEditingTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridCheckBoxColumn Header="Yer. Döküm" Width="75"
                                                        Binding="{Binding IsCastInSitu, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <DataGridTextColumn Header="Not" Width="*"
                                                        Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>

                                        <!-- Seçili katmanın parça sayısı (min / maks) -->
                                        <StackPanel Margin="0,6,0,0"
                                                    Visibility="{Binding SelectedTier, Converter={StaticResource NullToVis}}">
                                            <TextBlock FontSize="11" Foreground="Gray" Margin="0,0,0,4"
                                                       Text="Seçili katmanın parça sayısı (Min / Maks — ∞ = sınırsız, 0 = kullanma):"/>
                                            <DataGrid ItemsSource="{Binding TierConstraints}" MaxHeight="150"
                                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                                      SelectionMode="Single" HeadersVisibility="Column"
                                                      ColumnHeaderStyle="{StaticResource SutunBasligi}">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                                <Setter Property="Foreground" Value="Gray"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Parça Tipi" Width="140" IsReadOnly="True"
                                                        Binding="{Binding RoleDisplay}"/>
                                                    <DataGridTemplateColumn Header="Min" Width="70">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding MinCount}" HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}"/>
                                                                    <ComboBox ItemsSource="{Binding ZeroOneOptions}"
                                                                              SelectedItem="{Binding MinCount, UpdateSourceTrigger=PropertyChanged}"
                                                                              Visibility="{Binding IsEditableZeroOrOne, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBox Text="{Binding MinCount, UpdateSourceTrigger=PropertyChanged}"
                                                                             Visibility="{Binding IsEditableFree, Converter={StaticResource BoolToVis}}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Maks" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding MaxDisplay}" HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}"/>
                                                                    <ComboBox ItemsSource="{Binding ZeroOneOptions}"
                                                                              SelectedItem="{Binding MaxCount, UpdateSourceTrigger=PropertyChanged}"
                                                                              Visibility="{Binding IsEditableZeroOrOne, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBox Text="{Binding MaxCountText, UpdateSourceTrigger=PropertyChanged}"
                                                                             ToolTip="Bir sayı ya da sınırsız için ∞ yazın"
                                                                             Visibility="{Binding IsEditableFree, Converter={StaticResource BoolToVis}}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Kullanımdan Parça Çıkar — user-added rows per (family, Ø); decoupled from connection rules -->
                                <GroupBox Header="Kullanımdan Parça Çıkar" Padding="6" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="İsteğe bağlı: bir Taban (aile — Ø) ekleyin, o Taban'a bağlı parçalardan kullanmayacaklarınızın işaretini kaldırın. Gövde/Koni o çapa göre süzülür; Boyun/Kapak tümü. Aile listesi = ağın ana ailesi + bu ağın baca istisna aileleri. Aynı (aile, çap) bir kez eklenebilir."
                                                   Foreground="Gray" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <TextBlock Text="Taban ekle:" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox Width="240" Margin="0,0,6,0"
                                                      ItemsSource="{Binding AvailablePieceOptions}"
                                                      DisplayMemberPath="Display"
                                                      SelectedItem="{Binding SelectedPieceOption, Mode=TwoWay}"/>
                                            <Button Content="+ Ekle" Command="{Binding AddPieceRowCommand}" Padding="8,3"/>
                                        </WrapPanel>
                                        <ItemsControl ItemsSource="{Binding PieceRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E0E0E0" BorderThickness="1"
                                                            Padding="6" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,4">
                                                                <Button DockPanel.Dock="Right" Content="Sil" Padding="6,1"
                                                                        Command="{Binding DataContext.DeletePieceRowCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <TextBlock Text="{Binding Header}" FontWeight="Bold"
                                                                           VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                            <ItemsControl ItemsSource="{Binding Roles}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="70"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding RoleName}"
                                                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Heights}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <CheckBox Content="{Binding Label}"
                                                                                                  IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                                                                                  Margin="0,0,12,2" VerticalAlignment="Center"/>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Kazı Kuralları (filtre) — pick global rules by name; soil-narrowed -->
                                <GroupBox Header="Kazı Kuralları (filtre)" Padding="8" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Bu ağa uygulanacak kazı kurallarını ada göre seçin (Zemin Tipi'ne göre süzülür). Hiçbiri seçilmezse zemin filtresini geçen tüm kurallar geçerlidir."
                                                   Foreground="Gray" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Boru Hendek Kuralları" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <ItemsControl ItemsSource="{Binding PipeTrenchFilters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Baca Kazı Kuralları" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <ItemsControl ItemsSource="{Binding ManholeExcavFilters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <TextBlock Text="Baca çapı = seçilen ailenin o çaptaki Taban'ından çözülür. Kazı kuralı seçimi/istisnası fiyat + geometriyi zemin tipine ve seçilen kural adlarına göre süzer."
                                           Foreground="Gray" FontStyle="Italic" FontSize="11"
                                           Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                          </ScrollViewer>
                        </Border>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Text="Soldaki listeden bir ağ seçin." Foreground="Gray" FontStyle="Italic"
                                   Visibility="{Binding IsNetworkSelected, Converter={StaticResource BoolToVis},
                                                ConverterParameter=invert}"/>
                    </Grid>
                </DockPanel>
            </TabItem>


            <TabItem Header="Tür Eşleştirme">
                <typeMap:TypeMappingTabView DataContext="{Binding TypeMappingTab}"/>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════
                 Genel Ayarlar — Metraj hesap ayarları (eskiden Metraj penceresindeki
                 ⚙ Ayarlar). WinForms paneli WindowsFormsHost ile gömülür; Kaydet
                 ayarları aktif DWG'ye yazar (DwgBoQStore.SaveSettings).
                 ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="Genel Ayarlar">
                <DockPanel Margin="6">
                    <Border DockPanel.Dock="Top"
                            BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                            Background="#F8F8F8" Padding="6,5">
                        <WrapPanel>
                            <Button Content="💾 Kaydet" Click="GeneralSettings_Save_Click"
                                    Style="{StaticResource KaydetButton}" Margin="0,0,8,0"
                                    ToolTip="Genel ayarları aktif çizime (DWG) kaydeder.&#x0a;Metraj penceresinde Hesapla ile uygulanır."/>
                            <TextBlock x:Name="_settingsStatus" VerticalAlignment="Center"
                                       Foreground="Gray" FontSize="11"
                                       Text="Ayarlar aktif çizimden yüklendi."/>
                        </WrapPanel>
                    </Border>
                    <wfi:WindowsFormsHost x:Name="_settingsHost"/>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
