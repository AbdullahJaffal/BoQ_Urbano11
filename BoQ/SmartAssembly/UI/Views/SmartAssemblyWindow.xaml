<Window x:Class="UrbanoMetraj.BoQ.SmartAssembly.UI.Views.SmartAssemblyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:UrbanoMetraj.BoQ.SmartAssembly.UI.Converters"
        Title="Akıllı Baca Montaj Sistemi"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="580"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:NullToVisibilityConverter  x:Key="NullToVis"/>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVis"/>

        <Style x:Key="SutunBasligi" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="4,2"/>
            <Setter Property="Background" Value="#F0F0F0"/>
        </Style>

        <!-- Invalid pipe range row — red background -->
        <Style x:Key="BoruAralikSatiri" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPipeRangeValid}" Value="False">
                    <Setter Property="Background" Value="#FFCCCC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Invalid depth tier row — red background -->
        <Style x:Key="DerinlikKatmanSatiri" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDepthRangeValid}" Value="False">
                    <Setter Property="Background" Value="#FFCCCC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Local-override rule row — italic yellow -->
        <Style x:Key="YerelPipeRangeSatiri" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPipeRangeValid}" Value="False">
                    <Setter Property="Background" Value="#FFCCCC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock Text="Akıllı Baca Montaj — Veri Temeli v1.0"
                           Foreground="Gray" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="4">

            <!-- ═══════════════════════════════════════════════════════════════
                 SEKME 1  —  Ana Bileşen Deposu
                 ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="Ana Bileşen Deposu">
                <DockPanel Margin="6">

                    <ToolBarTray DockPanel.Dock="Top">
                        <ToolBar>
                            <Label Content="Yeni tip:" VerticalAlignment="Center"/>
                            <ComboBox Width="130"
                                      ItemsSource="{Binding RepositoryTab.AllRoles}"
                                      SelectedItem="{Binding RepositoryTab.NewRole}"/>
                            <Button Content="+ Ekle"   Command="{Binding RepositoryTab.AddCommand}"       Margin="4,0,0,0"/>
                            <Button Content="Çoğalt"   Command="{Binding RepositoryTab.DuplicateCommand}" Margin="2,0,0,0"
                                    ToolTip="Seçili bileşeni kopyala (yeni GUID, '- Kopya' eki)"/>
                            <Button Content="Sil"      Command="{Binding RepositoryTab.DeleteCommand}"    Margin="2,0,0,0"/>
                            <Separator/>
                            <Button Content="💾 Kaydet"
                                    Command="{Binding RepositoryTab.SaveCurrentCommand}"
                                    ToolTip="Son kullanılan dosyaya hızlı kaydet (ilk kullanımda dosya seçim ekranı açılır)"/>
                            <Button Content="Dışa Aktar"
                                    Command="{Binding RepositoryTab.SaveXmlCommand}"
                                    Margin="2,0,0,0"
                                    ToolTip="Kataloğu XML dosyasına aktar (farklı konuma)"/>
                            <Button Content="İçe Aktar"
                                    Command="{Binding RepositoryTab.LoadXmlCommand}"
                                    Margin="2,0,0,0"
                                    ToolTip="XML katalog dosyasından içe aktar"/>
                        </ToolBar>
                    </ToolBarTray>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bileşenler — 4 sütun -->
                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding RepositoryTab.Components}"
                                  SelectedItem="{Binding RepositoryTab.SelectedComponent}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single"
                                  ColumnHeaderStyle="{StaticResource SutunBasligi}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Poz No"
                                    Binding="{Binding PozNo, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="Ad"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Rol"
                                    Binding="{Binding RoleDisplay}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Yükseklik (mm)"
                                    Binding="{Binding TotalHeightMm, StringFormat=0}"
                                    IsReadOnly="True" Width="100"
                                    ElementStyle="{x:Null}"
                                    EditingElementStyle="{x:Null}"/>
                                <DataGridTextColumn Header="Aile Etiketi"
                                    Binding="{Binding FamilyTag, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                        <!-- Detay Paneli -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8"
                                        Visibility="{Binding RepositoryTab.IsComponentSelected,
                                                     Converter={StaticResource BoolToVis}}">

                                <TextBlock Text="Bileşen Detayı"
                                           FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                                <!-- Ortak alanlar -->
                                <Label Content="Poz No:"/>
                                <TextBox Text="{Binding RepositoryTab.SelectedComponent.PozNo,
                                                UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                <Label Content="Ad:"/>
                                <TextBox Text="{Binding RepositoryTab.SelectedComponent.Name,
                                                UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>

                                <!-- Etkin Yükseklik + değişken checkbox -->
                                <DockPanel Margin="0,2,0,0">
                                    <CheckBox Content="değişken"
                                              DockPanel.Dock="Right"
                                              IsChecked="{Binding RepositoryTab.SelectedComponent.IsVariable,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" Margin="6,0,0,0"
                                              ToolTip="İşaretlendiğinde yükseklik değişken (saha ayarı) — elle giriş ve kompozit hesap devre dışı"/>
                                    <Label Content="Etkin Yükseklik (mm):" Padding="5,0,0,0"
                                           ToolTip="Kompozit seçiliyse alt parça toplamından otomatik hesaplanır"/>
                                </DockPanel>
                                <TextBox Text="{Binding RepositoryTab.SelectedComponent.EffectiveHeight,
                                                UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding RepositoryTab.SelectedComponent.IsEffectiveHeightReadOnly}"
                                         Margin="0,0,0,2">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RepositoryTab.SelectedComponent.IsEffectiveHeightReadOnly}" Value="True">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                    <Setter Property="FontStyle"  Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="(Baca Yüksekliğine Bağlı)"
                                           FontSize="10" Foreground="Gray" FontStyle="Italic"
                                           Margin="0,0,0,4"
                                           Visibility="{Binding RepositoryTab.SelectedComponent.IsEffectiveHeightReadOnly,
                                                        Converter={StaticResource BoolToVis}}"/>

                                <Label Content="Aile Etiketi:"/>
                                <TextBox Text="{Binding RepositoryTab.SelectedComponent.FamilyTag,
                                                UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                <Label Content="Malzeme:"/>
                                <TextBox Text="{Binding RepositoryTab.SelectedComponent.Malzeme,
                                                UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Malzeme türü (örn. C30/37 Beton, HDPE, Dökme Demir)"
                                         Margin="0,0,0,4"/>
                                <Label Content="Dış Hacim (m³):"
                                       ToolTip="Bileşenin toplam mekânsal hacmi"/>
                                <TextBox Text="{Binding RepositoryTab.SelectedComponent.ExternalVolume,
                                                UpdateSourceTrigger=PropertyChanged, StringFormat=0.0000}"
                                         Margin="0,0,0,4"/>
                                <Label Content="Malzeme Hacmi (m³):"
                                       ToolTip="Net beton / HDPE hacmi"/>
                                <TextBox Text="{Binding RepositoryTab.SelectedComponent.MaterialVolume,
                                                UpdateSourceTrigger=PropertyChanged, StringFormat=0.0000}"
                                         Margin="0,0,0,4"/>

                                <!-- Zorunlu Parça — tüm tipler için BottomElement hariç -->
                                <CheckBox Content="Zorunlu Parça"
                                          IsChecked="{Binding RepositoryTab.SelectedComponent.ZorunluParca,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding RepositoryTab.SelectedComponent.ShowZorunluParca,
                                                       Converter={StaticResource BoolToVis}}"
                                          ToolTip="Bu bileşen her montajda zorunlu olarak yer alır"
                                          Margin="0,0,0,4"/>

                                <!-- Yükseltme Parçası — sadece MiddleElement ve Adjuster -->
                                <CheckBox Content="Yükseltme Parçası"
                                          IsChecked="{Binding RepositoryTab.SelectedComponent.YukseltmeParcasi,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding RepositoryTab.SelectedComponent.ShowYukseltmeParcasi,
                                                       Converter={StaticResource BoolToVis}}"
                                          ToolTip="Bu halka yükseltme amacıyla kullanılır"
                                          Margin="0,0,0,6"/>

                                <!-- BottomElement -->
                                <StackPanel Visibility="{Binding RepositoryTab.IsBottomElementSelected,
                                                         Converter={StaticResource BoolToVis}}">
                                    <Separator Margin="0,2,0,6"/>
                                    <TextBlock Text="Taban Geometrisi" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Label Content="Plan Şekli:"/>
                                    <ComboBox ItemsSource="{Binding RepositoryTab.AllFootprintShapes}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Shape"
                                              SelectedValue="{Binding RepositoryTab.SelectedComponent.PlanShape,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,0,4"/>

                                    <!-- Dairesel -->
                                    <StackPanel Visibility="{Binding RepositoryTab.SelectedComponent.IsCircularFootprint,
                                                             Converter={StaticResource BoolToVis}}">
                                        <Label Content="Taban Çapı (mm):"/>
                                        <TextBox Text="{Binding RepositoryTab.SelectedComponent.FootprintDiamMm,
                                                         UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                    </StackPanel>

                                    <!-- Kare -->
                                    <StackPanel Visibility="{Binding RepositoryTab.SelectedComponent.IsSquareFootprint,
                                                             Converter={StaticResource BoolToVis}}">
                                        <Label Content="Kenar Uzunluğu (mm):"/>
                                        <TextBox Text="{Binding RepositoryTab.SelectedComponent.FootprintSideMm,
                                                         UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                    </StackPanel>

                                    <!-- Dikdörtgen -->
                                    <StackPanel Visibility="{Binding RepositoryTab.SelectedComponent.IsRectangularFootprint,
                                                             Converter={StaticResource BoolToVis}}">
                                        <Label Content="Uzun Kenar (mm):"/>
                                        <TextBox Text="{Binding RepositoryTab.SelectedComponent.FootprintLengthMm,
                                                         UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                        <Label Content="Kısa Kenar (mm):"/>
                                        <TextBox Text="{Binding RepositoryTab.SelectedComponent.FootprintWidthMm,
                                                         UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                        <Label Content="Uzun Kenar Yönü:"
                                               ToolTip="Dikdörtgen tabanın uzun kenarının boru yönüne göre konumu"/>
                                        <ComboBox ItemsSource="{Binding RepositoryTab.FootprintOrientationOptions}"
                                                  SelectedItem="{Binding RepositoryTab.SelectedComponent.FootprintOrientation,
                                                                 UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,4"/>
                                    </StackPanel>

                                    <Label Content="Et Kalınlığı (mm):"/>
                                    <TextBox Text="{Binding RepositoryTab.SelectedComponent.WallThicknessMm,
                                                    UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                    <Label Content="Taban Kalınlığı (mm):"
                                           ToolTip="Kaide plakasının yapısal kalınlığı — DataGrid sütununda Etkin Yüksekliğe eklenir"/>
                                    <TextBox Text="{Binding RepositoryTab.SelectedComponent.TabanKalinligiMm,
                                                    UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                    <Label Content="Üst Açılış Çapı (mm):"
                                           ToolTip="Şaft halkasının oturduğu iç açıklık"/>
                                    <TextBox Text="{Binding RepositoryTab.SelectedComponent.TopOpeningDiamMm,
                                                    UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                    <CheckBox IsChecked="{Binding RepositoryTab.SelectedComponent.IsCompositeChecked,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding RepositoryTab.SelectedComponent.IsCompositeEnabled}"
                                              Content="Kompozit Alt Parçalı" Margin="0,0,0,4"/>
                                    <StackPanel Visibility="{Binding RepositoryTab.SelectedComponent.IsCompositeChecked,
                                                             Converter={StaticResource BoolToVis}}">
                                        <DockPanel Margin="0,4,0,2">
                                            <TextBlock Text="Alt Parçalar" FontWeight="SemiBold"
                                                       DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="+ Parça"
                                                        Command="{Binding RepositoryTab.AddSubPieceCommand}"
                                                        Padding="4,1" Margin="0,0,2,0"/>
                                                <Button Content="Sil"
                                                        Command="{Binding RepositoryTab.DeleteSubPieceCommand}"
                                                        Padding="4,1"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DataGrid ItemsSource="{Binding RepositoryTab.SubPieces}"
                                                  SelectedItem="{Binding RepositoryTab.SelectedSubPiece}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  MaxHeight="160"
                                                  ColumnHeaderStyle="{StaticResource SutunBasligi}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Ad"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"/>
                                                <DataGridTextColumn Header="H (mm)"
                                                    Binding="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0}"
                                                    Width="65"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- MiddleElement / Adjuster -->
                                <StackPanel Visibility="{Binding RepositoryTab.IsMiddleOrAdjusterSelected,
                                                         Converter={StaticResource BoolToVis}}">
                                    <Separator Margin="0,2,0,6"/>
                                    <TextBlock Text="Gövde / Ayar Halkası" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Label Content="İç Çap (mm):"/>
                                    <TextBox Text="{Binding RepositoryTab.SelectedComponent.InnerDiamMm,
                                                    UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                    <Label Content="Et Kalınlığı (mm):"/>
                                    <TextBox Text="{Binding RepositoryTab.SelectedComponent.WallThicknessMm,
                                                    UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                </StackPanel>

                                <!-- Reducer -->
                                <StackPanel Visibility="{Binding RepositoryTab.IsReducerSelected,
                                                         Converter={StaticResource BoolToVis}}">
                                    <Separator Margin="0,2,0,6"/>
                                    <TextBlock Text="Konik Geçiş" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Label Content="Alt İç Çap (mm):"/>
                                    <TextBox Text="{Binding RepositoryTab.SelectedComponent.BottomDiamMm,
                                                    UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                    <Label Content="Üst İç Çap (mm):"/>
                                    <TextBox Text="{Binding RepositoryTab.SelectedComponent.TopDiamMm,
                                                    UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                    <Label Content="Et Kalınlığı (mm):"/>
                                    <TextBox Text="{Binding RepositoryTab.SelectedComponent.WallThicknessMm,
                                                    UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                </StackPanel>

                                <!-- Cover -->
                                <StackPanel Visibility="{Binding RepositoryTab.IsCoverSelected,
                                                         Converter={StaticResource BoolToVis}}">
                                    <Separator Margin="0,2,0,6"/>
                                    <TextBlock Text="Rögar Kapağı" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Label Content="Yük Sınıfı (EN 124):"
                                           ToolTip="Örnek: A15, B125, C250, D400, E600, F900"/>
                                    <TextBox Text="{Binding RepositoryTab.SelectedComponent.LoadClass,
                                                    UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                    <Label Content="Net Açıklık (mm):"/>
                                    <TextBox Text="{Binding RepositoryTab.SelectedComponent.ClearOpeningMm,
                                                    UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════
                 SEKME 2  —  Ana Kural Matrisi  (Hiyerarşik: Boru → Derinlik)
                 ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="Ana Kural Matrisi">
                <DockPanel Margin="6">

                    <!-- Toolbar -->
                    <ToolBarTray DockPanel.Dock="Top">
                        <ToolBar>
                            <TextBlock Text="Boru Aralığı:" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <Button Content="+ Ekle"   Command="{Binding MasterRulesTab.AddPipeRangeCommand}"/>
                            <Button Content="Çoğalt"   Command="{Binding MasterRulesTab.DuplicatePipeRangeCommand}" Margin="2,0,0,0"
                                    ToolTip="Seçili boru aralığını tüm katmanlarıyla birlikte kopyala"/>
                            <Button Content="Sil"      Command="{Binding MasterRulesTab.DeletePipeRangeCommand}"   Margin="2,0,0,0"/>
                            <Separator/>
                            <Button Content="↑ Yukarı" Command="{Binding MasterRulesTab.MoveUpCommand}"
                                    ToolTip="Boru aralığını öncelik sırasında yukarı taşı"/>
                            <Button Content="↓ Aşağı"  Command="{Binding MasterRulesTab.MoveDownCommand}" Margin="2,0,0,0"/>
                            <Separator/>
                            <TextBlock Text="Derinlik Katmanı:" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <Button Content="+ Ekle"   Command="{Binding MasterRulesTab.AddTierCommand}"/>
                            <Button Content="Sil"      Command="{Binding MasterRulesTab.DeleteTierCommand}" Margin="2,0,0,0"/>
                            <Separator/>
                            <Button Content="💾 Kaydet"
                                    Command="{Binding MasterRulesTab.SaveCommand}"
                                    ToolTip="Kural matrisini cihaza kaydet (SmartAssemblyRules.xml)"/>
                            <Button Content="Dışa Aktar"
                                    Command="{Binding MasterRulesTab.ExportCommand}"
                                    Margin="2,0,0,0"
                                    ToolTip="Kural matrisini seçilen XML dosyasına aktar"/>
                            <Button Content="İçe Aktar"
                                    Command="{Binding MasterRulesTab.ImportCommand}"
                                    Margin="2,0,0,0"
                                    ToolTip="XML dosyasından kural matrisi içe aktar"/>
                        </ToolBar>
                    </ToolBarTray>

                    <TextBlock DockPanel.Dock="Top" Margin="4,4,0,4"
                               Text="Boru aralığı seçin → derinlik katmanlarını sağda düzenleyin.  Kırmızı satır = geçersiz aralık."
                               FontStyle="Italic" Foreground="Gray" FontSize="11"/>

                    <!-- Master-Detail split -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol: Boru Çapı Aralıkları -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Boru Çapı Aralıkları"
                                       FontWeight="Bold" Margin="0,0,0,4"/>
                            <DataGrid x:Name="MasterPipeRangesGrid"
                                      ItemsSource="{Binding MasterRulesTab.PipeRanges}"
                                      SelectedItem="{Binding MasterRulesTab.SelectedPipeRange}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      SelectionMode="Single"
                                      RowStyle="{StaticResource BoruAralikSatiri}"
                                      ColumnHeaderStyle="{StaticResource SutunBasligi}">
                                <DataGrid.Columns>

                                    <!-- 1 — Pipe Family -->
                                    <DataGridTemplateColumn Header="Aile" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SelectedPipeFamily.FamilyName, FallbackValue='—'}"
                                                           VerticalAlignment="Center" Padding="3,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding AvailableFamilies}"
                                                          SelectedItem="{Binding SelectedPipeFamily,
                                                                         UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMemberPath="FamilyName"
                                                          IsEditable="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 2 — Min Pipe (populated by selected family) -->
                                    <DataGridTemplateColumn Header="Min Boru" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SelectedMinPipe.Display, FallbackValue='—'}"
                                                           VerticalAlignment="Center" Padding="3,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding PipesInFamily}"
                                                          SelectedItem="{Binding SelectedMinPipe,
                                                                         UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMemberPath="Display"
                                                          IsEditable="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 3 — Max Pipe (same family list) -->
                                    <DataGridTemplateColumn Header="Max Boru" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SelectedMaxPipe.Display, FallbackValue='—'}"
                                                           VerticalAlignment="Center" Padding="3,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding PipesInFamily}"
                                                          SelectedItem="{Binding SelectedMaxPipe,
                                                                         UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMemberPath="Display"
                                                          IsEditable="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Katman"
                                        Binding="{Binding TierCount}" IsReadOnly="True" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                        <!-- Sağ: Derinlik Katmanları (seçili boru aralığı için) -->
                        <DockPanel Grid.Column="2"
                                   Visibility="{Binding MasterRulesTab.IsPipeRangeSelected,
                                                Converter={StaticResource BoolToVis}}">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBlock FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <Binding Path="MasterRulesTab.SelectedPipeRange.PipeRangeDisplay"
                                                 StringFormat="Derinlik Katmanları — {0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DockPanel>
                            <DataGrid x:Name="MasterTiersGrid"
                                      DockPanel.Dock="Top"
                                      ItemsSource="{Binding MasterRulesTab.SelectedPipeRange.DepthTiers}"
                                      SelectedItem="{Binding MasterRulesTab.SelectedDepthTier}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      SelectionMode="Single"
                                      RowStyle="{StaticResource DerinlikKatmanSatiri}"
                                      ColumnHeaderStyle="{StaticResource SutunBasligi}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Min Der. (m)"
                                        Binding="{Binding MinDepthM, UpdateSourceTrigger=PropertyChanged, StringFormat=0.0}"
                                        Width="90"/>
                                    <DataGridTextColumn Header="Max Der. (m)"
                                        Binding="{Binding MaxDepthM, UpdateSourceTrigger=PropertyChanged, StringFormat=0.0}"
                                        Width="90"/>
                                    <DataGridCheckBoxColumn Header="Yd. Döküm"
                                        Binding="{Binding IsCastInSitu, UpdateSourceTrigger=PropertyChanged}"
                                        Width="80"/>
                                    <DataGridTemplateColumn Header="Seçilen Taban" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ResultDisplay}"
                                                           VerticalAlignment="Center" Padding="2,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                    ItemsSource="{Binding DataContext.MasterRulesTab.AvailableBases,
                                                                  ElementName=MasterTiersGrid}"
                                                    SelectedValue="{Binding SelectedBaseId,
                                                                    UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    SelectedValuePath="Id"
                                                    DisplayMemberPath="Display"
                                                    IsEnabled="{Binding IsBaseSelectable}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Not"
                                        Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Yer tutucu: boru aralığı seçilmemiş -->
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Text="Soldaki listeden bir boru çapı aralığı seçin veya '+ Ekle' ile yeni oluşturun."
                                   Foreground="Gray" FontStyle="Italic"
                                   Visibility="{Binding MasterRulesTab.IsPipeRangeSelected,
                                                Converter={StaticResource BoolToVis},
                                                ConverterParameter=invert}"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════
                 SEKME 3  —  Proje Kurulumu (DWG)
                 ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="Proje Kurulumu (DWG)">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol: şablon listesi -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Proje Şablonları"
                                   FontWeight="Bold" Margin="0,0,0,4"/>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="+ Yeni"
                                    Command="{Binding ProjectSetupTab.NewTemplateCommand}"
                                    Width="54" ToolTip="Yeni şablon oluştur"/>
                            <Button Content="Çoğalt"
                                    Command="{Binding ProjectSetupTab.DuplicateTemplateCommand}"
                                    Width="52" Margin="2,0,0,0"
                                    ToolTip="Seçili şablonu tüm kurallarıyla kopyala"/>
                            <Button Content="Sil"
                                    Command="{Binding ProjectSetupTab.DeleteTemplateCommand}"
                                    Width="36" Margin="2,0,0,0"/>
                            <Button Content="DWG'ye Kaydet"
                                    Command="{Binding ProjectSetupTab.SaveToNodCommand}"
                                    Width="95" Margin="0,4,0,0"
                                    ToolTip="Seçili şablonu aktif DWG NOD'una kaydet"/>
                            <Button Content="DWG'den Yükle"
                                    Command="{Binding ProjectSetupTab.LoadFromNodCommand}"
                                    Width="95" Margin="0,2,0,0"/>
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding ProjectSetupTab.Templates}"
                                 SelectedItem="{Binding ProjectSetupTab.SelectedTemplate}"
                                 DisplayMemberPath="TemplateName"/>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                    <!-- Sağ: şablon editörü -->
                    <DockPanel Grid.Column="2"
                               Visibility="{Binding ProjectSetupTab.IsTemplateSelected,
                                            Converter={StaticResource BoolToVis}}">

                        <!-- Başlık alanları -->
                        <Border DockPanel.Dock="Top"
                                BorderBrush="#CCC" BorderThickness="0,0,0,1"
                                Padding="0,0,0,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Şablon Adı:"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,4"
                                         Text="{Binding ProjectSetupTab.TemplateName,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Kazı Profili:"
                                       ToolTip="Harici hendek kataloğundaki kazı profili anahtar adı"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,4"
                                          IsEditable="True"
                                          ItemsSource="{Binding ProjectSetupTab.AvailableExcavationProfiles}"
                                          Text="{Binding ProjectSetupTab.AssociatedExcavationProfile,
                                                 UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Malzeme Filtresi:"
                                       ToolTip="Sadece bu FamilyTag değerine sahip parçalar seçilir."/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2,0,0"
                                          IsEditable="True"
                                          ItemsSource="{Binding ProjectSetupTab.AvailableMaterialFamilies}"
                                          Text="{Binding ProjectSetupTab.MaterialFamilyOverride,
                                                 UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>

                        <!-- Yerel kurallar araç çubuğu -->
                        <ToolBarTray DockPanel.Dock="Top">
                            <ToolBar>
                                <TextBlock Text="Boru Aralığı:" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <Button Content="Ana Katlogdan İçe Aktar"
                                        Command="{Binding ProjectSetupTab.ImportFromMasterCommand}"
                                        ToolTip="Ana kuralları bu şablona klonla"/>
                                <Separator/>
                                <Button Content="+ Ekle"
                                        Command="{Binding ProjectSetupTab.AddLocalPipeRangeCommand}"/>
                                <Button Content="Çoğalt"
                                        Command="{Binding ProjectSetupTab.DuplicateLocalPipeRangeCommand}"
                                        Margin="2,0,0,0" ToolTip="Seçili boru aralığını kopyala"/>
                                <Button Content="Sil"
                                        Command="{Binding ProjectSetupTab.DeleteLocalPipeRangeCommand}"
                                        Margin="2,0,0,0"/>
                                <Separator/>
                                <TextBlock Text="Katman:" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <Button Content="+ Ekle"
                                        Command="{Binding ProjectSetupTab.AddLocalTierCommand}"/>
                                <Button Content="Sil"
                                        Command="{Binding ProjectSetupTab.DeleteLocalTierCommand}"
                                        Margin="2,0,0,0"/>
                            </ToolBar>
                        </ToolBarTray>

                        <!-- Yerel kurallar Master-Detail -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sol: Yerel boru aralıkları -->
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="Yerel Boru Aralıkları"
                                           FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                <DataGrid x:Name="LocalPipeRangesGrid"
                                          ItemsSource="{Binding ProjectSetupTab.LocalPipeRanges}"
                                          SelectedItem="{Binding ProjectSetupTab.SelectedLocalPipeRange}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          SelectionMode="Single"
                                          RowStyle="{StaticResource BoruAralikSatiri}"
                                          ColumnHeaderStyle="{StaticResource SutunBasligi}">
                                    <DataGrid.Columns>

                                        <!-- 1 — Pipe Family -->
                                        <DataGridTemplateColumn Header="Aile" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SelectedPipeFamily.FamilyName, FallbackValue='—'}"
                                                               VerticalAlignment="Center" Padding="3,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding AvailableFamilies}"
                                                              SelectedItem="{Binding SelectedPipeFamily,
                                                                             UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMemberPath="FamilyName"
                                                              IsEditable="False"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- 2 — Min Pipe -->
                                        <DataGridTemplateColumn Header="Min Boru" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SelectedMinPipe.Display, FallbackValue='—'}"
                                                               VerticalAlignment="Center" Padding="3,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding PipesInFamily}"
                                                              SelectedItem="{Binding SelectedMinPipe,
                                                                             UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMemberPath="Display"
                                                              IsEditable="False"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- 3 — Max Pipe -->
                                        <DataGridTemplateColumn Header="Max Boru" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SelectedMaxPipe.Display, FallbackValue='—'}"
                                                               VerticalAlignment="Center" Padding="3,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding PipesInFamily}"
                                                              SelectedItem="{Binding SelectedMaxPipe,
                                                                             UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMemberPath="Display"
                                                              IsEditable="False"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Kat."
                                            Binding="{Binding TierCount}" IsReadOnly="True" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                            <!-- Sağ: Derinlik katmanları -->
                            <DockPanel Grid.Column="2"
                                       Visibility="{Binding ProjectSetupTab.IsLocalPipeRangeSelected,
                                                    Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4">
                                    <TextBlock.Text>
                                        <Binding Path="ProjectSetupTab.SelectedLocalPipeRange.PipeRangeDisplay"
                                                 StringFormat="Derinlik Katmanları — {0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                                <DataGrid x:Name="LocalTiersGrid"
                                          ItemsSource="{Binding ProjectSetupTab.SelectedLocalPipeRange.DepthTiers}"
                                          SelectedItem="{Binding ProjectSetupTab.SelectedLocalTier}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          SelectionMode="Single"
                                          RowStyle="{StaticResource DerinlikKatmanSatiri}"
                                          ColumnHeaderStyle="{StaticResource SutunBasligi}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Min Der. (m)"
                                            Binding="{Binding MinDepthM, UpdateSourceTrigger=PropertyChanged, StringFormat=0.0}"
                                            Width="85"/>
                                        <DataGridTextColumn Header="Max Der. (m)"
                                            Binding="{Binding MaxDepthM, UpdateSourceTrigger=PropertyChanged, StringFormat=0.0}"
                                            Width="85"/>
                                        <DataGridCheckBoxColumn Header="Yd. Döküm"
                                            Binding="{Binding IsCastInSitu, UpdateSourceTrigger=PropertyChanged}"
                                            Width="75"/>
                                        <DataGridTemplateColumn Header="Seçilen Taban" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ResultDisplay}"
                                                               VerticalAlignment="Center" Padding="2,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox
                                                        ItemsSource="{Binding DataContext.ProjectSetupTab.AvailableBases,
                                                                      ElementName=LocalTiersGrid}"
                                                        SelectedValue="{Binding SelectedBaseId,
                                                                        UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        SelectedValuePath="Id"
                                                        DisplayMemberPath="Display"
                                                        IsEnabled="{Binding IsBaseSelectable}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Not"
                                            Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                            Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <!-- Yer tutucu: boru aralığı seçilmemiş -->
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Text="Bir boru aralığı seçin veya '+ Ekle' ile yeni oluşturun."
                                       Foreground="Gray" FontStyle="Italic"
                                       Visibility="{Binding ProjectSetupTab.IsLocalPipeRangeSelected,
                                                    Converter={StaticResource BoolToVis},
                                                    ConverterParameter=invert}"/>
                        </Grid>
                    </DockPanel>

                    <!-- Şablon seçilmediğinde yer tutucu -->
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Text="Soldaki listeden bir şablon seçin veya '+' ile yeni oluşturun."
                               Foreground="Gray" FontStyle="Italic"
                               Visibility="{Binding ProjectSetupTab.IsTemplateSelected,
                                            Converter={StaticResource BoolToVis},
                                            ConverterParameter=invert}"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
