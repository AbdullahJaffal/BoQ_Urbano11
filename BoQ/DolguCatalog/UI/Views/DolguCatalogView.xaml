<UserControl x:Class="UrbanoMetraj.BoQ.DolguCatalog.UI.Views.DolguCatalogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:UrbanoMetraj.BoQ.SmartAssembly.UI.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="4,2"/>
            <Setter Property="Background" Value="#F0F0F0"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin"  Value="0,0,4,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- ── Status bar ──────────────────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="Gray" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                Background="#F8F8F8" Padding="6,5">
            <WrapPanel>

                <Button Content="+ Ekle"  Command="{Binding AddCommand}"
                        Style="{StaticResource ActionBtn}"/>
                <Button Content="Çoğalt"  Command="{Binding DuplicateCommand}"
                        Style="{StaticResource ActionBtn}"/>
                <Button Content="Sil"     Command="{Binding DeleteCommand}"
                        Style="{StaticResource ActionBtn}"/>

                <Separator Width="1" Height="22" Margin="6,0" Background="#CCCCCC"/>

                <Button Content="💾 Kaydet" Command="{Binding SaveCommand}"
                        Style="{StaticResource ActionBtn}"
                        ToolTip="Dolgu kataloğunu dahili konuma kaydeder&#x0a;(%APPDATA%\UrbanoMetraj\DolguCatalog.xml)"/>

                <Button Content="Dışa Aktar" Command="{Binding ExportCommand}"
                        Style="{StaticResource ActionBtn}"
                        ToolTip="Kataloğu seçilen konuma XML olarak dışa aktarır."/>

                <Button Content="İçe Aktar" Command="{Binding ImportCommand}"
                        Style="{StaticResource ActionBtn}"
                        ToolTip="Daha önce dışa aktarılmış bir XML dosyasını içe aktarır."/>

            </WrapPanel>
        </Border>

        <!-- ── Main grid ───────────────────────────────────────────────────── -->
        <DataGrid Margin="6"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Single"
                  ColumnHeaderStyle="{StaticResource ColHeader}">
            <DataGrid.Columns>

                <DataGridTextColumn Header="Poz No"
                    Binding="{Binding BoqItemCode, UpdateSourceTrigger=PropertyChanged}"
                    Width="110"/>

                <DataGridTextColumn Header="Dolgu Malzemesi"
                    Binding="{Binding DolguAdi, UpdateSourceTrigger=PropertyChanged}"
                    Width="*"/>

                <DataGridTextColumn Header="Açıklama"
                    Binding="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}"
                    Width="*"/>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
